# ========================================================
#       إعدادات بيئة الإنتاج - نظام المقاولات CRM
# ========================================================

# منفذ تشغيل الخادم
PORT=3000
NODE_ENV=production

# المفتاح السري لتشفير جلسات الـ JWT (يرجى تغييره في بيئة الإنتاج الحية)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_KEY

# بيانات الاتصال بقاعدة بيانات PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

